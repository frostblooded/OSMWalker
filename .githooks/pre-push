#!/bin/sh
# Refuses a push that fails the checks. Turn it on once per clone:
#   git config core.hooksPath .githooks
# Cargo checks the files on disk, so they must be the commit being pushed.
set -e
head=$(git rev-parse HEAD)
while read -r _lref lsha _rref _rsha; do
  [ "$lsha" = 0000000000000000000000000000000000000000 ] && continue # a branch delete
  [ "$(git rev-parse "$lsha^{commit}")" = "$head" ] || { echo "Check out the commit you push first: the hook checks the files on disk."; exit 1; }
done
[ -z "$(git status --porcelain)" ] || { echo "Commit or stash first: the hook checks the files on disk."; exit 1; }
cargo fmt --check
cargo clippy --all-targets -- -D warnings
cargo test --quiet
