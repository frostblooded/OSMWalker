#!/bin/sh
# Refuses a push that fails the checks. Turn it on once per clone:
#   git config core.hooksPath .githooks
# Cargo checks the files on disk, so they must match what is committed.
set -e
[ -z "$(git status --porcelain)" ] || { echo "Commit or stash first: the hook checks the files on disk."; exit 1; }
cargo fmt --check
cargo clippy --all-targets -- -D warnings
cargo test --quiet
